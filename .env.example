# =============================================================================
# Lenny Growth Assistant — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env or any file containing real credentials.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# DB_TARGET tells compose and the health endpoint which path is active.
# Values: "supabase" | "local"
DB_TARGET="supabase"

# Supabase session-mode pooler (IPv4, supports prepared statements).
# Get from: Project Settings > Database > Connect > Session mode (port 5432)
# Username format is always postgres.<project-ref>
# Do NOT add ?sslmode=... — configure TLS with SUPABASE_SSL_REQUIRED below.
DATABASE_URL="postgresql+asyncpg://postgres.<project-ref>:[PWD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Sync URL for Alembic migrations — same host/port as DATABASE_URL but uses psycopg2 driver
ALEMBIC_DATABASE_URL="postgresql://postgres.<project-ref>:[PWD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase connection mode ───────────────────────────────────────────────────
# "session" (default) — IPv4, prepared statements supported
# "transaction" — prepared statements disabled automatically; use port 6543
# "direct" — IPv6 only (needs IPv4 add-on); port 5432, username postgres
SUPABASE_POOL_MODE="session"

# Set to true for Supabase cloud (TLS is enforced). False for local Postgres.
SUPABASE_SSL_REQUIRED="true"

# Optional: path to downloaded project root cert for verify-full mode.
# Download from: Project Settings > Database > SSL Certificate
# Leave empty to verify against system CAs.
# SUPABASE_CA_CERT_PATH="/path/to/prod-ca-2021.crt"

# ── LLM Provider ─────────────────────────────────────────────────────────────
# "ollama" (default, local) or "groq" (cloud)
LLM_PROVIDER="ollama"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# ── Embedding provider ────────────────────────────────────────────────────────
# EMBEDDING_PROVIDER: "ollama" (default) | "nomic"
# If EMBEDDING_FALLBACK_ENABLED=true and Ollama is unreachable, the Nomic Atlas
# API is tried (requires NOMIC_API_KEY). Both failing returns grounded refusal.
# EMBEDDING_DIM is a hard contract — never change without a full re-ingest.
EMBEDDING_PROVIDER="ollama"
EMBEDDING_FALLBACK_ENABLED="false"
NOMIC_API_KEY=""
EMBEDDING_DIM="768"

# ── Agent Sidecar ─────────────────────────────────────────────────────────────
AGENT_SIDECAR_URL="http://agent-sidecar:4000"

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV="development"
LOG_LEVEL="INFO"
CORS_ORIGINS="http://localhost:5173"

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE="20"

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_SHIP30_SKILL="true"
ENABLE_HTML_ARTIFACTS="true"
